APP_NAME="Territorial Army"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=territorial_army
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_CONNECTION=log
CACHE_STORE=database
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_LIFETIME=120

# ---------- Mail ----------
# For local dev: `log` writes emails to storage/logs/laravel.log
# For production: switch to `smtp` or `ses` and fill the creds.
# Resend will be re-added in Phase 6 once Resend's Laravel 12 support lands.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@jointerritorialarmy.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---------- File Storage (Cloudflare R2) ----------
FILESYSTEM_DISK=r2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=territorial-army
AWS_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
AWS_URL=https://cdn.jointerritorialarmy.com
AWS_USE_PATH_STYLE_ENDPOINT=true

# ---------- Razorpay ----------
RAZORPAY_KEY=
RAZORPAY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---------- Admin seed ----------
ADMIN_NAME="Super Admin"
ADMIN_EMAIL=admin@jointerritorialarmy.com
ADMIN_PASSWORD=ChangeMe123!
